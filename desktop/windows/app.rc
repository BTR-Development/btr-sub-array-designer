// Icon (id 1, the one wWinMain loads), manifest and version info.
// VERSION_DOTS / VERSION_COMMAS / GIT_REV come from build-windows.sh.
#include <winver.h>

1 ICON "AppIcon.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VERSION_COMMAS
PRODUCTVERSION VERSION_COMMAS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "BTR Solutions"
      VALUE "LegalCopyright", "Author: Karol Bernacki"
      VALUE "FileDescription", "BTR Sub Array Designer"
      VALUE "FileVersion", VERSION_DOTS
      VALUE "ProductName", "BTR Sub Array Designer"
      VALUE "ProductVersion", VERSION_DOTS
      VALUE "Comments", GIT_REV
      VALUE "OriginalFilename", "BTRSubArrayDesigner.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
